select
  stg.pedido_id,
  cast(stg.quantidade as int64) as quantidade,
  cast(stg.preco_unitario_centavos as int64) as preco_unitario_centavos,
  cast(stg.quantidade as int64) * cast(stg.preco_unitario_centavos as int64)
    as valor_total_centavos,
  coalesce(stg.mdmDeleted, false) as mdmDeleted
  --metadata-v2--
from `stg_crm_demo_pedidos` as stg
qualify row_number() over (
  partition by stg.mdmId
  order by
    stg.mdmCounterForEntity desc,
    stg.mdmLastUpdated desc,
    stg._ingestionDatetime desc
) = 1
